{
  "name": "ng-flex-layout",
  "description": "Angular Flex Layout (DOIT fork)",
  "version": "21.2.9",
  "homepage": "https://github.com/alessiobianchini/ng-flex-layout",
  "bugs": "https://github.com/alessiobianchini/ng-flex-layout/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alessiobianchini/ng-flex-layout.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.9.0 || ^22.16.0"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build ng-flex-layout",
    "build-demo-app": "ng build demo-app",
    "publish": "cd dist/releases/flex-layout && npm publish --access public --no-git-checks",
    "demo:serve": "ng serve demo-app",
    "stamp": "ts-node tools/package-tools/version-placeholders.ts --module=commonjs",
    "build:universal-demo-app": "ng run universal-demo-app:build:production",
    "serve:universal-demo-app": "pnpm -s build:universal-demo-app && pnpm -s serve:ssr:universal-demo-app",
    "test": "vitest",
    "test-ui": "vitest --ui",
    "lint": "node scripts/run-eslint.cjs \"projects/libs/**/*.{js,jsx,ts,tsx,html}\" --fix",
    "release": "pnpm run build && pnpm run stamp",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "serve:ssr:universal-demo-app": "node dist/universal-demo-app/server/server.mjs"
  },
  "private": true,
  "requiredAngularVersion": ">=22.0.0",
  "dependencies": {
    "@angular/animations": "~22.0.1",
    "@angular/common": "~22.0.1",
    "@angular/compiler": "~22.0.1",
    "@angular/core": "~22.0.1",
    "@angular/forms": "~22.0.1",
    "@angular/material": "~22.0.1",
    "@angular/platform-browser": "~22.0.1",
    "@angular/platform-browser-dynamic": "~22.0.1",
    "@angular/platform-server": "~22.0.1",
    "@angular/router": "~22.0.1",
    "@angular/ssr": "~22.0.1",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "~22.0.0",
    "@angular-eslint/eslint-plugin": "~22.0.0",
    "@angular-eslint/eslint-plugin-template": "~22.0.0",
    "@angular-eslint/schematics": "~22.0.0",
    "@angular-eslint/template-parser": "~22.0.0",
    "@angular/build": "~22.0.1",
    "@angular/cdk": "~22.0.1",
    "@angular/cli": "~22.0.1",
    "@angular/compiler-cli": "~22.0.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@testing-library/angular": "^19.4.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@typescript-eslint/types": "^8.61.1",
    "@typescript-eslint/utils": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "ng-packagr": "~22.0.0",
    "postcss": "^8.5.15",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.13.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9",
    "reflect-metadata": "^0.2.2"
  },
  "resolutions": {
    "https-proxy-agent": "7.0.4"
  }
}
